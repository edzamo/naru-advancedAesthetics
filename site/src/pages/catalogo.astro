---
import Layout from "../layouts/Layout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import PageHero from "../components/PageHero.astro";
import servicesData from "../data/services.json";
import siteData from "../data/site.json";

const categorias = servicesData.categorias;
const servicios = servicesData.servicios.filter((s: any) => s.activo);

const porCategoria = categorias.map((cat: any) => ({
	...cat,
	servicios: servicios.filter((s: any) => s.categoria === cat.id),
}));

// El catálogo "de verdad" lo arma y actualiza la diseñadora en Canva (fotos, precios,
// diseño) — no hace falta tocar código ni redeployar para que un cambio en Canva se
// refleje acá, el iframe siempre carga la última versión publicada en ese link.
// Mientras no exista un link real, se muestra la grilla generada desde services.json
// como respaldo (mismo criterio que GA4: sin config real, no se activa el embed) —
// ver docs/04-desarrollo.md.
const canvaEmbedUrl = siteData.canva_catalogo_embed_url;
const canvaLink = siteData.canva_catalogo_link;
---

<Layout
	title="Catálogo"
	description="Catálogo de tratamientos de Naru Estética Avanzada: micropigmentación, cejas, pestañas, faciales y estética láser."
>
	<PageHero
		eyebrow="Tratamientos"
		title="Catálogo"
		description="Precios y fotos en proceso de carga — el detalle exacto de cada tratamiento lo confirmamos por WhatsApp."
	/>

	<div class="container">
		{canvaEmbedUrl ? (
			<div class="canva-embed-wrap">
				<iframe
					loading="lazy"
					class="canva-embed"
					src={canvaEmbedUrl}
					allow="fullscreen"
					allowfullscreen
					title="Catálogo de tratamientos Naru"
				/>
			</div>
		) : servicios.length === 0 ? (
			<p class="placeholder">Catálogo en construcción — muy pronto vas a ver nuestros tratamientos acá.</p>
		) : (
			porCategoria
				.filter((cat: any) => cat.servicios.length > 0)
				.map((cat: any) => (
					<section class="categoria">
						<p class="eyebrow">{cat.servicios.length} tratamientos</p>
						<h2>{cat.nombre}</h2>
						<div class="grid">
							{cat.servicios.map((s: any) => (
								<ServiceCard
									nombre={s.nombre}
									precio={s.precio}
									moneda={s.moneda}
									descripcion={s.descripcion}
								/>
							))}
						</div>
					</section>
				))
		)}
		{canvaEmbedUrl && canvaLink && (
			<p class="canva-fallback-link">
				¿No se ve bien el catálogo? <a href={canvaLink} target="_blank" rel="noopener">Abrilo en Canva →</a>
			</p>
		)}
	</div>

	<style>
		.canva-embed-wrap {
			position: relative;
			width: 100%;
			/* Proporción real del catálogo (booklet vertical) tal como la da el código
			   de embed de Canva: padding-top 141.4286% ≈ ratio A4 (1 / √2). Con
			   aspect-ratio en vez de alto fijo, el iframe escala igual en cualquier
			   ancho de pantalla sin cortar contenido ni dejar franjas vacías. */
			max-width: 640px;
			margin: 0 auto;
			aspect-ratio: 1 / 1.4142857;
			border-radius: var(--radius);
			overflow: hidden;
			box-shadow: 0 8px 24px -12px rgba(39, 75, 26, 0.25);
		}

		.canva-embed {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			border: none;
		}

		.canva-fallback-link {
			text-align: center;
			margin-top: var(--space-4);
			font-size: var(--text-sm);
			color: var(--color-text-muted);
		}

		.canva-fallback-link a {
			color: var(--color-accent);
		}

		.categoria {
			margin-bottom: var(--space-12);
		}

		.categoria h2 {
			margin-top: var(--space-1);
		}

		.grid {
			display: grid;
			gap: var(--space-6);
			margin-top: var(--space-6);
		}

		.placeholder {
			color: var(--color-text-muted);
			font-style: italic;
			padding: var(--space-8) 0;
		}

		@media (min-width: 768px) {
			.grid {
				grid-template-columns: repeat(2, 1fr);
			}
		}

		@media (min-width: 1024px) {
			.grid {
				grid-template-columns: repeat(3, 1fr);
			}
		}
	</style>
</Layout>
