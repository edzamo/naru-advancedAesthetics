---
import Layout from "../layouts/Layout.astro";
import FlowerMotif from "../components/FlowerMotif.astro";
import siteData from "../data/site.json";

const porQueElegirnos = [
	{
		titulo: "Tecnología moderna",
		tituloEn: "Modern technology",
		texto: "Equipos y técnicas actualizadas, no lo de siempre.",
		textoEn: "Up-to-date equipment and techniques, not the usual routine.",
	},
	{
		titulo: "Atención personalizada",
		tituloEn: "Personalized attention",
		texto: "Cada clienta importa desde que entra hasta que sale.",
		textoEn: "Every client matters from the moment she walks in until she leaves.",
	},
	{
		titulo: "Ambiente cuidado",
		tituloEn: "A carefully designed space",
		texto: "Un espacio pensado con intención, en cada detalle.",
		textoEn: "A space designed with intention, down to every detail.",
	},
	{
		titulo: "Precio justo",
		tituloEn: "Fair pricing",
		texto: "Calidad real, sin pagar de más ni resignar resultados.",
		textoEn: "Real quality, without overpaying or settling for less.",
	},
];
---

<Layout
	title="Inicio"
	titleEn="Home"
	description="Naru Estética Avanzada — calidad real, tecnología moderna y atención personalizada en Manta, Ecuador."
>
	<section class="hero">
		<div class="hero-content">
			<p class="eyebrow eyebrow-light">Manta, Ecuador</p>
			<h1>
				<span data-i18n-en="Real beauty.">Belleza real.</span><br />
				<span data-i18n-en="Fair prices.">Precio justo.</span>
			</h1>
			<p class="hero-sub" data-i18n-en="The middle ground that was always missing: quality, warmth and a price that respects the people who choose us.">
				El punto medio que siempre faltó: calidad, calidez y un precio que respeta a quien
				nos elige.
			</p>
			<div class="hero-actions">
				<a class="btn btn-solid" href="/catalogo" data-i18n-en="View catalog">Ver catálogo</a>
				<a class="btn btn-outline" href="/contacto" data-i18n-en="Book now">Reservar</a>
			</div>
		</div>
	</section>

	<section class="apertura">
		<div class="container apertura-content">
			<FlowerMotif size={120} color="var(--color-oro)" opacity={0.35} />
			<p class="eyebrow eyebrow-light" data-i18n-en="Coming soon">Muy pronto</p>
			<h2 data-i18n-en="We're opening soon">Nos inauguramos</h2>
			<p class="apertura-fecha" data-i18n-en={siteData.fecha_apertura_display_en}>{siteData.fecha_apertura_display}</p>
			<p class="apertura-texto" data-i18n-en="We're getting everything ready to open Naru's doors in Manta. Here you'll see real photos from opening day and our clients' first results.">
				Estamos preparando todo para abrir las puertas de Naru en Manta. Acá vas a ver las
				fotos reales de la apertura y los primeros resultados de nuestras clientas.
			</p>
			{siteData.instagram && (
				<a class="link-underline" href={siteData.instagram} target="_blank" rel="noopener" data-i18n-en="Follow us for updates →">
					Seguinos para las novedades →
				</a>
			)}
		</div>
	</section>

	<section class="por-que">
		<div class="container">
			<p class="eyebrow" data-i18n-en="Why choose us">Por qué elegirnos</p>
			<h2 data-i18n-en="Naru in four words">Naru en cuatro palabras</h2>
			<ul class="reasons">
				{
					porQueElegirnos.map((item) => (
						<li>
							<FlowerMotif size={32} color="var(--color-oro)" />
							<div>
								<strong data-i18n-en={item.tituloEn}>{item.titulo}</strong>
								<span data-i18n-en={item.textoEn}>{item.texto}</span>
							</div>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="container section nosotros-extracto">
		<div class="quote-block">
			<FlowerMotif size={64} color="var(--color-oro)" opacity={0.7} />
			<blockquote data-i18n-en={'"I wanted a place to be proud of. One clients would remember not just for the result, but for how it made them feel."'}>
				"Quería un lugar del que estar orgullosa. Uno que las clientas recuerden no solo
				por el resultado, sino por cómo las hicieron sentir."
			</blockquote>
			<a class="link-underline" href="/nosotros" data-i18n-en="Learn our story →">Conocer nuestra historia →</a>
		</div>
	</section>

	<section class="ubicacion">
		<div class="container">
			<h2 data-i18n-en="Visit us">Visítanos</h2>
			<p>Manta, Ecuador</p>
			<a class="btn btn-solid" href="/contacto" data-i18n-en="Directions / Contact">Cómo llegar / Contacto</a>
		</div>
	</section>

	<style>
		.hero {
			/* Mockup de recepción del manual de marca (render 3D, no foto real del local) —
			   ver docs/04-desarrollo.md. Reemplazar por foto real cuando exista. */
			position: relative;
			overflow: hidden;
			display: flex;
			align-items: flex-end;
			min-height: 78vh;
			background-image: url("/images/hero-recepcion.webp");
			background-size: cover;
			background-position: center 30%;
			color: var(--color-arena);
			padding: var(--space-8) var(--space-4) calc(var(--space-12) * 1.6);
			text-align: left;
		}

		/* Scrim: cálido y liviano arriba (deja ver la madera/dorado real de la foto),
		   concentrado solo donde se necesita legibilidad, abajo — igual que clinicamilano.it,
		   que oscurece lo justo y deja respirar la fotografía. Nada de filtro verde plano.
		   En mobile el recorte de "cover" deja el wordmark "NARU" de la propia foto justo
		   donde va nuestro <h1> — se oscurece antes para que no compitan. */
		.hero::before {
			content: "";
			position: absolute;
			inset: 0;
			background: linear-gradient(
				180deg,
				rgba(20, 22, 16, 0.15) 0%,
				rgba(20, 22, 16, 0.4) 30%,
				rgba(20, 18, 14, 0.8) 55%,
				rgba(18, 16, 12, 0.88) 100%
			);
			pointer-events: none;
		}

		.hero-content {
			position: relative;
			z-index: 1;
			max-width: 520px;
			margin: 0;
		}

		.eyebrow-light {
			color: var(--color-naranja);
		}

		.hero h1 {
			font-size: var(--text-2xl);
			color: var(--color-arena);
			margin-top: var(--space-2);
		}

		.hero-sub {
			font-size: var(--text-base);
			color: var(--color-arena);
			opacity: 0.9;
			max-width: 40ch;
			margin: var(--space-4) 0 0;
		}

		.hero-actions {
			display: flex;
			flex-direction: column;
			gap: var(--space-3);
			margin-top: var(--space-6);
			align-items: flex-start;
		}

		.btn {
			display: inline-block;
			padding: var(--space-3) var(--space-8);
			border-radius: var(--radius);
			text-decoration: none;
			font-family: var(--font-heading);
			font-size: var(--text-sm);
			text-transform: uppercase;
			letter-spacing: var(--tracking-wide);
			transition: transform 0.2s ease, opacity 0.2s ease;
		}

		.btn:hover {
			transform: translateY(-2px);
		}

		.btn-solid {
			background: var(--color-naranja);
			color: var(--color-verde-botanico);
		}

		.btn-outline {
			border: 1px solid var(--color-arena);
			color: var(--color-arena);
		}

		.section {
			padding: var(--space-12) 0;
		}

		.section h2 {
			margin-top: var(--space-1);
		}

		/* Banner de apertura — reemplaza a "Destacados" mientras el local no abrió (2026-09-18):
		   antes de la inauguración no hay prueba social real que mostrar ("lo más pedido"
		   sería falso), así que en vez de ocultar la sección se usa el mismo hueco para
		   anunciar la fecha. Mismo tratamiento oscuro + glow cálido que .ubicacion (abajo),
		   pero centrado y con la flor grande como foco — es la sección que más quiere llamar
		   la atención de toda la home. fecha_apertura_display en site.json: confirmar la
		   fecha real antes de publicar, hoy es un valor de ejemplo. */
		.apertura {
			position: relative;
			overflow: hidden;
			background:
				radial-gradient(60% 90% at 50% 0%, rgba(194, 115, 68, 0.35) 0%, rgba(194, 115, 68, 0) 70%),
				var(--color-verde-botanico);
			color: var(--color-arena);
			text-align: center;
			padding: var(--space-12) 0;
		}

		.apertura-content {
			position: relative;
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: var(--space-2);
		}

		.apertura-content :global(svg) {
			position: absolute;
			top: -30px;
			left: 50%;
			transform: translateX(-50%);
			z-index: 0;
		}

		.apertura h2,
		.apertura-fecha,
		.apertura-texto,
		.apertura .link-underline {
			position: relative;
			z-index: 1;
		}

		.apertura h2 {
			color: var(--color-arena);
			margin: var(--space-2) 0 0;
		}

		.apertura-fecha {
			font-family: var(--font-display);
			font-size: var(--text-2xl);
			/* --color-oro, no --color-naranja: el manual reserva Naranja solo para fondo de
			   bloques destacados, nunca texto (ver tokens.css) — Oro sí está documentado
			   para "títulos grandes". */
			color: var(--color-oro);
			margin: 0;
		}

		.apertura-texto {
			max-width: 46ch;
			color: var(--color-arena);
			opacity: 0.85;
			margin: 0;
		}

		/* Selector con más especificidad que .link-underline (definida más abajo) a propósito
		   — si no, el orden de aparición en el archivo haría ganar el color por defecto
		   (Terracota) en vez de este, sobre el fondo oscuro. */
		.apertura .link-underline {
			color: var(--color-arena);
			border-bottom-color: var(--color-arena);
			margin-top: var(--space-2);
		}

		.por-que {
			background: linear-gradient(160deg, var(--color-arena-calida) 0%, var(--color-arena) 70%);
			color: var(--color-text);
			padding: var(--space-12) 0;
			border-top: 1px solid rgba(39, 75, 26, 0.08);
			border-bottom: 1px solid rgba(39, 75, 26, 0.08);
		}

		.por-que .eyebrow {
			color: var(--color-accent);
		}

		.reasons {
			list-style: none;
			margin: var(--space-6) 0 0;
			padding: 0;
			display: grid;
			gap: var(--space-6);
		}

		.reasons li {
			display: flex;
			align-items: flex-start;
			gap: var(--space-4);
		}

		.reasons strong {
			display: block;
			font-family: var(--font-heading);
			margin-bottom: var(--space-1);
		}

		.reasons span {
			font-size: var(--text-sm);
		}

		.quote-block {
			max-width: var(--max-content-width);
			margin: 0 auto;
			text-align: center;
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: var(--space-4);
		}

		blockquote {
			margin: 0;
			font-family: var(--font-display);
			font-style: italic;
			font-size: var(--text-lg);
			color: var(--color-verde-bosque);
		}

		.link-underline {
			font-family: var(--font-heading);
			font-size: var(--text-sm);
			text-transform: uppercase;
			letter-spacing: var(--tracking-wide);
			border-bottom: 1px solid var(--color-accent);
			padding-bottom: 2px;
		}

		.ubicacion {
			position: relative;
			overflow: hidden;
			background:
				radial-gradient(50% 70% at 12% 100%, rgba(194, 115, 68, 0.4) 0%, rgba(194, 115, 68, 0) 65%),
				var(--color-verde-botanico);
			color: var(--color-arena);
			text-align: center;
			padding: var(--space-12) 0;
		}

		.ubicacion h2 {
			color: var(--color-arena);
		}

		.ubicacion .btn-solid {
			margin-top: var(--space-4);
			display: inline-block;
		}

		@media (min-width: 768px) {
			.hero {
				min-height: 88vh;
				padding: var(--space-8) var(--space-8) calc(var(--space-12) * 2.2);
			}

			/* En desktop el h1 no se cruza con el wordmark de la foto — overlay más liviano,
			   deja ver mejor la madera y el logo dorado. */
			.hero::before {
				background: linear-gradient(
					180deg,
					rgba(20, 22, 16, 0.1) 0%,
					rgba(20, 22, 16, 0.25) 45%,
					rgba(20, 18, 14, 0.72) 82%,
					rgba(18, 16, 12, 0.85) 100%
				);
			}

			.hero-content {
				max-width: 620px;
			}

			.hero h1 {
				font-size: var(--text-3xl);
			}

			.hero-actions {
				flex-direction: row;
			}

			.grid-3 {
				grid-template-columns: repeat(3, 1fr);
			}

			.reasons {
				grid-template-columns: repeat(2, 1fr);
			}
		}
	</style>
</Layout>
