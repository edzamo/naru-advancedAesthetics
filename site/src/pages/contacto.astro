---
import Layout from "../layouts/Layout.astro";
import siteData from "../data/site.json";

const whatsappHref = siteData.whatsapp_numero
	? `https://wa.me/${siteData.whatsapp_numero}?text=${encodeURIComponent(siteData.whatsapp_mensaje)}`
	: null;

const ICONS = {
	whatsapp: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.6-.8-1.8-.9-.2-.1-.4-.1-.6.1-.2.3-.7.9-.8 1-.2.2-.3.2-.5.1-.3-.1-1.2-.4-2.2-1.4-.8-.7-1.4-1.6-1.5-1.9-.2-.3 0-.5.1-.6l.4-.5c.1-.1.2-.3.2-.4.1-.1 0-.3 0-.4-.1-.1-.6-1.4-.8-1.9-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.2.3-.9.9-.9 2.1 0 1.2.9 2.4 1 2.6.1.2 1.8 2.8 4.4 3.8.6.3 1.1.4 1.5.5.6.2 1.2.2 1.6.1.5-.1 1.6-.6 1.8-1.3.2-.6.2-1.2.2-1.3-.1-.1-.2-.2-.4-.3z"/><path d="M12 2C6.5 2 2 6.5 2 12c0 1.9.5 3.6 1.4 5.2L2 22l4.9-1.3C8.5 21.6 10.2 22 12 22c5.5 0 10-4.5 10-10S17.5 2 12 2zm0 18.2c-1.6 0-3.2-.4-4.5-1.2l-.3-.2-3.3.9.9-3.2-.2-.3C3.8 14.7 3.4 13.4 3.4 12 3.4 7.3 7.3 3.4 12 3.4S20.6 7.3 20.6 12 16.7 20.2 12 20.2z"/></svg>`,
	mapPin: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C7.6 2 4 5.6 4 10c0 5.7 6.9 11.1 7.2 11.3.2.2.6.2.8 0C12.3 21.1 20 15.7 20 10c0-4.4-3.6-8-8-8zm0 10.8c-1.6 0-2.8-1.3-2.8-2.8S10.4 7.2 12 7.2s2.8 1.3 2.8 2.8-1.2 2.8-2.8 2.8z"/></svg>`,
	calendar: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="5" width="17" height="16" rx="2"/><path d="M8 3v4M16 3v4M3.5 10h17"/><path d="M8 14h.01M12 14h.01M16 14h.01M8 17.5h.01M12 17.5h.01"/></svg>`,
	instagram: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2c2.7 0 3.1 0 4.1.1 1.1 0 1.8.2 2.4.4.6.3 1.1.6 1.7 1.1.5.5.9 1 1.1 1.7.2.6.4 1.3.4 2.4.1 1 .1 1.4.1 4.1s0 3.1-.1 4.1c0 1.1-.2 1.8-.4 2.4-.2.6-.6 1.1-1.1 1.7-.5.5-1 .9-1.7 1.1-.6.2-1.3.4-2.4.4-1 .1-1.4.1-4.1.1s-3.1 0-4.1-.1c-1.1 0-1.8-.2-2.4-.4-.6-.2-1.1-.6-1.7-1.1-.5-.5-.9-1-1.1-1.7-.2-.6-.4-1.3-.4-2.4C2 15.1 2 14.7 2 12s0-3.1.1-4.1c0-1.1.2-1.8.4-2.4.2-.6.6-1.2 1.1-1.7.5-.5 1-.9 1.7-1.1.6-.2 1.3-.4 2.4-.4C8.9 2 9.3 2 12 2zm0 5a5 5 0 100 10 5 5 0 000-10zm0 8.2A3.2 3.2 0 1112 8.8a3.2 3.2 0 010 6.4zm5.2-8.4a1.2 1.2 0 100-2.4 1.2 1.2 0 000 2.4z"/></svg>`,
	facebook: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7.5h2.5l.4-3h-2.9V8.4c0-.9.2-1.5 1.5-1.5h1.6V4.3c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.3H8v3h2.4V21h3.1z"/></svg>`,
	google: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.3l-4.7 2.8 1.2-5.3-4-3.5 5.4-.5L12 5.5l2.1 5.3 5.4.5-4 3.5 1.2 5.3z"/></svg>`,
};

// Reseñas de Google: pendiente el link directo al formulario de reseña (necesita el
// Place ID del negocio). Mientras tanto queda listo en el código pero SIN mostrarse —
// pedido explícito: no publicar hasta tener el link correcto, no la ficha genérica de Maps.
const googleReviewsHref = null; // TODO: link directo de reseñas (place id) cuando lo tengamos
---

<Layout
	title="Contacto"
	titleEn="Contact"
	description="Visita Naru Estética Avanzada en Manta, Ecuador — contáctanos por WhatsApp o redes sociales."
>
	<section class="contact-hero">
		<div class="contact-hero-content">
			<p class="escribenos" data-i18n-en="Write to us">Escríbenos</p>
			<h1 data-i18n-en="Contact">Contacto</h1>
			<p class="eyebrow eyebrow-light" data-i18n-en="We're here to help">Estamos para ayudarte</p>

			<div class="info-grid">
				<div class="info-block">
					<p class="eyebrow" data-i18n-en="Location">Ubicación</p>
					<p class="info-value">{siteData.direccion || "Manta, Ecuador"}</p>
					{siteData.google_maps_link && (
						<a class="info-action" href={siteData.google_maps_link} target="_blank" rel="noopener">
							<span class="icon-circle icon-circle-sm icon-mappin" set:html={ICONS.mapPin} />
							<span class="direccion-hint" data-i18n-en="Google Maps location">Ubicación Google Maps</span>
						</a>
					)}
				</div>

				<div class="info-block">
					<p class="eyebrow" data-i18n-en="Phone">Teléfono</p>
					<p class="info-value">{siteData.telefono_display}</p>
					{whatsappHref && (
						<a class="info-action" href={whatsappHref} target="_blank" rel="noopener">
							<span class="icon-circle icon-circle-sm icon-whatsapp" set:html={ICONS.whatsapp} />
							<span class="direccion-hint" data-i18n-en="Message on WhatsApp">Escribir por WhatsApp</span>
						</a>
					)}
				</div>

				<div class="info-block">
					<p class="eyebrow" data-i18n-en="Hours">Horario</p>
					<p class="info-value" data-i18n-en={siteData.horario_en || "Coming soon."}>{siteData.horario || "Próximamente."}</p>
					<div class="info-static">
						<span class="icon-circle icon-circle-sm icon-horario" set:html={ICONS.calendar} />
						<span class="direccion-hint" data-i18n-en="Business hours">Horario de atención</span>
					</div>
				</div>
			</div>

			<div class="social-block">
				<p class="social-heading" data-i18n-en="Follow us">Seguinos</p>
				<div class="follow-grid">
					{siteData.instagram && (
						<a class="follow-card" href={siteData.instagram} target="_blank" rel="noopener">
							<span class="icon-circle" set:html={ICONS.instagram} />
							<span class="follow-name">Instagram</span>
							<span class="follow-promise" data-i18n-en="See our clients' real results">Mirá los resultados reales de nuestras clientas</span>
						</a>
					)}
					{siteData.facebook && (
						<a class="follow-card" href={siteData.facebook} target="_blank" rel="noopener">
							<span class="icon-circle" set:html={ICONS.facebook} />
							<span class="follow-name">Facebook</span>
							<span class="follow-promise" data-i18n-en="Promotions and studio news">Promociones y novedades del studio</span>
						</a>
					)}
					{googleReviewsHref && (
						<a class="follow-card" href={googleReviewsHref} target="_blank" rel="noopener">
							<span class="icon-circle" set:html={ICONS.google} />
							<span class="follow-name">Google</span>
							<span class="follow-promise" data-i18n-en="Leave us a review">Dejanos tu reseña</span>
						</a>
					)}
				</div>
			</div>
		</div>
	</section>

	<style>
		/* Mockup de tarjeta de presentación del manual de marca (render 3D) — ver
		   docs/04-desarrollo.md. Una sola imagen para toda la página: título, datos de
		   contacto y accesos a redes conviven sobre el mismo fondo con overlay, en vez
		   de partir la página en dos fotos distintas (se veía cortada/ancha). */
		.contact-hero {
			position: relative;
			overflow: hidden;
			display: flex;
			align-items: center;
			justify-content: center;
			background-image: url("/images/hero-contacto.webp");
			background-size: cover;
			background-position: center 30%;
			text-align: center;
			padding: var(--space-10) 0;
		}

		.contact-hero::before {
			content: "";
			position: absolute;
			inset: 0;
			background: linear-gradient(
				180deg,
				rgba(20, 22, 16, 0.55) 0%,
				rgba(20, 22, 16, 0.72) 35%,
				rgba(20, 22, 16, 0.85) 100%
			);
			pointer-events: none;
		}

		.contact-hero-content {
			position: relative;
			z-index: 1;
			color: var(--color-arena);
			width: 100%;
			max-width: var(--max-content-width);
			padding: 0 var(--space-4);
		}

		.escribenos {
			font-family: var(--font-display);
			font-style: italic;
			font-size: var(--text-xl);
			color: var(--color-oro);
			margin: 0 0 var(--space-1);
		}

		.contact-hero h1 {
			color: var(--color-arena);
			margin-bottom: var(--space-2);
		}

		.eyebrow-light {
			color: var(--color-naranja);
		}

		/* El .eyebrow global usa Terracota (pensado para fondos claros, ver tokens.css).
		   Sobre esta foto oscura leía como un rojo suelto, desentonado del dorado/naranja
		   que ya usamos en el resto del hero — lo alineamos al mismo cálido. */
		.contact-hero-content :global(.eyebrow) {
			color: var(--color-naranja);
		}

		.info-grid {
			display: grid;
			gap: var(--space-6);
			margin: var(--space-8) 0;
			padding-top: var(--space-8);
			border-top: 1px solid rgba(243, 240, 232, 0.25);
		}

		/* Alinea las 3 filas (etiqueta / dato / acción) entre las tres columnas aunque
		   la dirección ocupe más líneas que el teléfono o el horario — antes cada bloque
		   crecía por su cuenta y los íconos quedaban a distinta altura. */
		@media (min-width: 768px) {
			.info-grid {
				grid-template-rows: auto 1fr auto;
			}

			.info-block {
				display: grid;
				grid-template-rows: subgrid;
				grid-row: span 3;
			}
		}

		.info-block p:not(.eyebrow) {
			margin: var(--space-1) 0 0;
			color: var(--color-arena);
		}

		.info-value {
			margin: var(--space-1) 0 0;
			color: var(--color-arena);
		}

		/* Mismo patrón para Ubicación y Teléfono: dato + ícono-acción debajo,
		   para que ambos bloques queden homogéneos entre sí. */
		.info-action {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: var(--space-1);
			margin-top: var(--space-2);
			text-decoration: none;
			color: var(--color-arena);
		}

		/* Horario no enlaza a ningún lado, pero repite el mismo patrón visual
		   (ícono + etiqueta) para que las tres columnas queden homogéneas. */
		.info-static {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: var(--space-1);
			margin-top: var(--space-2);
			color: var(--color-arena);
		}

		.direccion-hint {
			font-family: var(--font-heading);
			font-size: var(--text-xs);
			text-transform: uppercase;
			letter-spacing: var(--tracking-wide);
			color: var(--color-naranja);
		}

		.icon-circle-sm {
			width: 40px;
			height: 40px;
		}

		.icon-circle-sm :global(svg) {
			width: 18px;
			height: 18px;
		}

		/* WhatsApp lleva su propio verde (ver tokens.css) — sin esta regla heredaba el
		   Terracota de los enlaces globales y se veía rojo, desentonando del resto. */
		.icon-whatsapp {
			color: var(--color-whatsapp);
			border-color: var(--color-whatsapp);
		}

		/* Ubicación usa Oro (dorado de marca) — distingue la acción de mapa de la de
		   WhatsApp sin salirse de la paleta cálida ya usada en el resto del hero. */
		.icon-mappin {
			color: var(--color-oro);
			border-color: var(--color-oro);
		}

		/* Horario usa Naranja (el mismo cálido de "Estamos para ayudarte") — un tercer
		   acento de marca distinto al dorado y al verde de WhatsApp. */
		.icon-horario {
			color: var(--color-naranja);
			border-color: var(--color-naranja);
		}

		.info-action:hover .icon-circle:not(.icon-whatsapp):not(.icon-mappin) {
			background: var(--color-arena);
			color: var(--color-verde-botanico);
		}

		.info-action:hover .icon-whatsapp {
			background: var(--color-whatsapp);
			color: var(--color-arena);
		}

		.info-action:hover .icon-mappin {
			background: var(--color-oro);
			color: var(--color-verde-botanico);
		}

		.social-block {
			padding-top: var(--space-8);
			border-top: 1px solid rgba(243, 240, 232, 0.25);
		}

		.social-heading {
			font-family: var(--font-heading);
			font-weight: 600;
			max-width: 24ch;
			margin: 0 auto var(--space-6);
		}

		/* Tarjetas de "Seguinos": a diferencia de Ubicación/Teléfono/Horario (utilidad,
		   la persona ya sabe qué quiere), acá hace falta una promesa corta por red para
		   que dé ganas de hacer clic — ver docs/08-redes-sociales.md. */
		.follow-grid {
			display: flex;
			gap: var(--space-4);
			align-items: stretch;
			justify-content: center;
			flex-wrap: wrap;
		}

		.follow-card {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: var(--space-2);
			width: 180px;
			padding: var(--space-4) var(--space-3);
			border-radius: var(--radius);
			border: 1px solid rgba(243, 240, 232, 0.25);
			color: var(--color-arena);
			text-decoration: none;
			text-align: center;
			transition: background 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
		}

		.icon-circle {
			display: flex;
			align-items: center;
			justify-content: center;
			width: 56px;
			height: 56px;
			border-radius: 50%;
			border: 1px solid var(--color-arena);
			background: rgba(20, 22, 16, 0.25);
			transition: background 0.2s ease;
		}

		.icon-circle :global(svg) {
			width: 24px;
			height: 24px;
		}

		.follow-card:hover {
			background: rgba(243, 240, 232, 0.08);
			border-color: var(--color-arena);
			transform: translateY(-2px);
		}

		.follow-card:hover .icon-circle {
			background: var(--color-arena);
			color: var(--color-verde-botanico);
		}

		.follow-name {
			font-family: var(--font-heading);
			font-size: var(--text-sm);
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: var(--tracking-wide);
		}

		.follow-promise {
			font-size: var(--text-xs);
			color: var(--color-arena);
			opacity: 0.8;
			line-height: 1.4;
		}

		@media (min-width: 768px) {
			.contact-hero {
				padding: var(--space-10) 0;
			}

			.escribenos {
				font-size: var(--text-2xl);
			}

			.info-grid {
				grid-template-columns: repeat(3, 1fr);
			}

			.follow-grid {
				gap: var(--space-6);
			}
		}
	</style>
</Layout>
