---
/**
 * Motivo decorativo inspirado en el isotipo de Naru (flor de 6 pétalos en apertura, trazo lineal).
 * Interpretación propia en SVG mientras no tengamos el archivo vectorial oficial del manual
 * (ver docs/04-desarrollo.md — pendiente solicitar al diseñador). No reemplaza al logo real
 * en contextos donde se requiera la marca oficial (header, favicon) — es un ornamento gráfico
 * para fondos/secciones, coherente en trazo y simetría con el isotipo descrito en 01-marca.md.
 */
interface Props {
	size?: number;
	color?: string;
	opacity?: number;
	class?: string;
}

const { size = 200, color = "currentColor", opacity = 1, class: className = "" } = Astro.props;

const petal = "M0,-58 C18,-44 18,-14 0,0 C-18,-14 -18,-44 0,-58 Z";
const angles = [0, 60, 120, 180, 240, 300];
---

<svg
	class={className}
	width={size}
	height={size}
	viewBox="-70 -70 140 140"
	fill="none"
	stroke={color}
	stroke-width="1.5"
	opacity={opacity}
	aria-hidden="true"
>
	{angles.map((a) => <path d={petal} transform={`rotate(${a})`} />)}
</svg>
