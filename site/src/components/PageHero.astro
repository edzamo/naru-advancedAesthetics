---
/**
 * Encabezado estándar de páginas internas (Catálogo): solo título, sin foto de fondo.
 * Decisión de UX: en una página de catálogo/listado, el fondo debe ser neutro para que
 * las tarjetas de tratamientos (y sus fotos reales, cuando existan) sean lo protagonista —
 * ver docs/04-desarrollo.md. Distinto de Inicio/Nosotros, que sí usan foto de marca porque
 * ahí el objetivo es transmitir identidad, no facilitar comparación rápida.
 */
interface Props {
	eyebrow: string;
	title: string;
	description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section class="page-hero">
	<div class="container">
		<p class="eyebrow">{eyebrow}</p>
		<h1>{title}</h1>
		{description && <p class="intro">{description}</p>}
	</div>
</section>

<style>
	.page-hero {
		text-align: center;
		padding: var(--space-6) 0 var(--space-4);
	}

	.intro {
		color: var(--color-text-muted);
		max-width: 48ch;
		margin: var(--space-2) auto 0;
	}

	@media (min-width: 768px) {
		.page-hero {
			padding: var(--space-8) 0 var(--space-4);
		}
	}
</style>
