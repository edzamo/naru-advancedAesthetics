---
import "../styles/tokens.css";
import FlowerMotif from "../components/FlowerMotif.astro";

interface Props {
	title: string;
	description: string;
	image?: string;
}

const { title, description, image = "/images/og-default.jpg" } = Astro.props;
const fullTitle = `${title} · Naru Estética Avanzada`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const ogImageUrl = new URL(image, Astro.site ?? Astro.url.origin);

// GA4 — no se carga nada hasta tener un Measurement ID real configurado.
// Ver docs/04-desarrollo.md para instrucciones de alta y dónde poner la variable en Netlify.
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;

const navLinks = [
	{ href: "/", label: "Inicio" },
	{ href: "/nosotros", label: "Nosotros" },
	{ href: "/catalogo", label: "Catálogo" },
	{ href: "/contacto", label: "Contacto" },
];
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />

		<!-- Open Graph (vista previa al compartir por WhatsApp/Instagram/Facebook) -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Naru Estética Avanzada" />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:locale" content="es_EC" />

		<!-- Twitter Card (fallback, misma info que Open Graph) -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600&family=Playfair+Display:ital,wght@0,500;0,600;1,500&family=Work+Sans:wght@400;500&display=swap"
			rel="stylesheet"
		/>

		{gaId && (
			<>
				<script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
				<script define:vars={{ gaId }}>
					window.dataLayer = window.dataLayer || [];
					function gtag() { dataLayer.push(arguments); }
					gtag("js", new Date());
					gtag("config", gaId);
				</script>
			</>
		)}
	</head>
	<body>
		<header class="site-header">
			<a href="/" class="brand" aria-label="Naru Estética Avanzada">
				<FlowerMotif size={28} color="var(--color-oro)" class="brand-mark" />
				<img
					class="brand-wordmark"
					src="/images/brand/wordmark-arena.webp"
					alt="Naru Estética Avanzada"
					width="220"
					height="77"
				/>
			</a>
			<input type="checkbox" id="nav-toggle" class="nav-toggle" />
			<label for="nav-toggle" class="nav-toggle-label" aria-label="Abrir menú">
				<span></span>
			</label>
			<nav class="site-nav">
				<ul>
					{
						navLinks.map((link) => (
							<li>
								<a href={link.href}>{link.label}</a>
							</li>
						))
					}
				</ul>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<FlowerMotif size={56} color="var(--color-oro)" class="footer-flower" />
			<img
				class="footer-wordmark"
				src="/images/brand/wordmark-arena.webp"
				alt="Naru Estética Avanzada"
				width="220"
				height="77"
			/>
			<p class="footer-tagline">Belleza real. Precio justo.</p>
			<p class="footer-location">Manta, Ecuador</p>
			<p>
				<a href="/contacto">Contacto / WhatsApp</a>
			</p>
		</footer>

		<script>
			// Rastreo de eventos reales del sitio (GA4) por delegación: un solo listener
			// clasifica el clic según a dónde apunta el link, en vez de repetir listeners
			// por página. No hace nada si GA4 todavía no está configurado (ver Layout.astro).
			document.addEventListener("click", (event) => {
				const gtag = (window as any).gtag;
				if (typeof gtag !== "function") return;

				const link = (event.target as HTMLElement)?.closest("a");
				if (!link) return;

				const href = link.getAttribute("href") || "";

				if (href.includes("wa.me")) {
					gtag("event", "click_whatsapp", { link_url: href });
				} else if (href.includes("instagram.com")) {
					gtag("event", "click_instagram", { link_url: href });
				} else if (href.includes("facebook.com")) {
					gtag("event", "click_facebook", { link_url: href });
				} else if (href.includes("maps.app.goo.gl") || href.includes("google.com/maps")) {
					gtag("event", "click_maps", { link_url: href });
				} else if (href === "/catalogo") {
					gtag("event", "click_ver_catalogo", { from_path: location.pathname });
				} else if (href === "/contacto") {
					gtag("event", "click_reservar", { from_path: location.pathname });
				}
			});
		</script>

		<style>
			:global(*) {
				box-sizing: border-box;
			}

			:global(html) {
				scroll-behavior: smooth;
			}

			:global(body) {
				margin: 0;
				background: var(--color-bg);
				color: var(--color-text);
				font-family: var(--font-body);
				font-size: var(--text-base);
				line-height: 1.6;
			}

			:global(h1),
			:global(h2),
			:global(h3) {
				font-family: var(--font-display);
				font-weight: 600;
				color: var(--color-text);
				margin: 0 0 var(--space-4);
				line-height: 1.15;
			}

			:global(a) {
				color: var(--color-accent);
			}

			:global(.container) {
				max-width: 1100px;
				margin: 0 auto;
				padding: 0 var(--space-4);
			}

			:global(.eyebrow) {
				font-family: var(--font-heading);
				font-size: var(--text-xs);
				text-transform: uppercase;
				letter-spacing: var(--tracking-wide);
				color: var(--color-accent);
			}

			.site-header {
				position: relative;
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: var(--space-4) var(--space-5, var(--space-4));
				background: var(--color-verde-botanico);
			}

			.brand {
				display: flex;
				align-items: center;
				gap: var(--space-2);
				text-decoration: none;
			}

			.brand :global(.brand-mark) {
				display: block;
			}

			/* Wordmark real del manual de marca (portada, recortado y recoloreado a Arena) —
			   ver docs/04-desarrollo.md. No es texto con fuente web: es el logotipo exacto,
			   con el detalle del trazo que conecta la A con la R, imposible de replicar con
			   una fuente del sistema. */
			.brand-wordmark {
				height: 36px;
				width: auto;
			}

			@media (min-width: 768px) {
				.brand-wordmark {
					height: 40px;
				}
			}

			.nav-toggle {
				display: none;
			}

			.nav-toggle-label {
				display: flex;
				flex-direction: column;
				gap: 5px;
				cursor: pointer;
			}

			.nav-toggle-label span,
			.nav-toggle-label::before,
			.nav-toggle-label::after {
				content: "";
				width: 22px;
				height: 1.5px;
				background: var(--color-arena);
				display: block;
			}

			.site-nav {
				position: absolute;
				top: 100%;
				left: 0;
				right: 0;
				background: var(--color-verde-botanico);
				display: none;
				border-top: 1px solid rgba(241, 239, 239, 0.15);
			}

			.nav-toggle:checked ~ .site-nav {
				display: block;
			}

			.site-nav ul {
				list-style: none;
				margin: 0;
				padding: var(--space-4) var(--space-5, var(--space-4));
				display: flex;
				flex-direction: column;
				gap: var(--space-4);
			}

			.site-nav a {
				color: var(--color-arena);
				text-decoration: none;
				font-family: var(--font-heading);
				font-size: var(--text-sm);
				text-transform: uppercase;
				letter-spacing: var(--tracking-wide);
				opacity: 0.9;
				transition: opacity 0.2s;
			}

			.site-nav a:hover {
				opacity: 1;
			}

			main {
				display: block;
			}

			.site-footer {
				background: var(--color-verde-botanico);
				color: var(--color-arena);
				text-align: center;
				padding: var(--space-12) var(--space-4) var(--space-8);
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: var(--space-1);
			}

			.footer-flower {
				margin-bottom: var(--space-2);
				opacity: 0.9;
			}

			.footer-wordmark {
				height: 44px;
				width: auto;
				margin-bottom: var(--space-1);
			}

			.footer-tagline {
				margin: 0;
				font-size: var(--text-sm);
				color: var(--color-arena);
				opacity: 0.75;
			}

			.footer-location {
				margin: var(--space-2) 0 0;
				font-size: var(--text-sm);
			}

			.site-footer a {
				color: var(--color-naranja);
				font-family: var(--font-heading);
				font-size: var(--text-sm);
				text-decoration: none;
			}

			/* Desktop (>= 768px): nav siempre visible, sin hamburguesa */
			@media (min-width: 768px) {
				.site-header {
					padding: var(--space-4) var(--space-8);
				}

				.nav-toggle-label {
					display: none;
				}

				.site-nav {
					position: static;
					display: block;
					background: none;
					border-top: none;
				}

				.site-nav ul {
					flex-direction: row;
					padding: 0;
					gap: var(--space-8);
				}
			}
		</style>
	</body>
</html>
