---
import "../styles/tokens.css";

interface Props {
	title: string;
	titleEn?: string;
	description: string;
	image?: string;
	noindex?: boolean;
}

const { title, titleEn, description, image = "/images/og-default.jpg", noindex = false } = Astro.props;
const fullTitle = `${title} · Naru Estética Avanzada`;
const fullTitleEn = titleEn ? `${titleEn} · Naru Advanced Aesthetics` : null;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const ogImageUrl = new URL(image, Astro.site ?? Astro.url.origin);

// GA4 — no se carga nada hasta tener un Measurement ID real configurado.
// Ver docs/04-desarrollo.md para instrucciones de alta y dónde poner la variable en Netlify.
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const currentYear = new Date().getFullYear();

const navLinks = [
	{ href: "/", label: "Inicio", labelEn: "Home" },
	{ href: "/nosotros", label: "Nosotros", labelEn: "About" },
	{ href: "/catalogo", label: "Catálogo", labelEn: "Catalog" },
	{ href: "/contacto", label: "Contacto", labelEn: "Contact" },
];
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title data-i18n-en={fullTitleEn ?? undefined}>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}

		<!-- Open Graph (vista previa al compartir por WhatsApp/Instagram/Facebook) -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Naru Estética Avanzada" />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:locale" content="es_EC" />

		<!-- Twitter Card (fallback, misma info que Open Graph) -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600&family=Playfair+Display:ital,wght@0,500;0,600;1,500&family=Work+Sans:wght@400;500&display=swap"
			rel="stylesheet"
		/>

		{gaId && (
			<>
				<script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
				<script is:inline src="/scripts/analytics.js" data-ga-id={gaId}></script>
			</>
		)}
	</head>
	<body>
		<header class="site-header">
			<a href="/" class="brand" aria-label="Naru Estética Avanzada">
				<img
					class="brand-mark"
					src="/images/brand/flor-oro.webp"
					alt=""
					width="28"
					height="28"
				/>
				<img
					class="brand-wordmark"
					src="/images/brand/wordmark-arena.webp"
					alt="Naru Estética Avanzada"
					width="220"
					height="77"
				/>
			</a>
			<div class="header-right">
				<input type="checkbox" id="nav-toggle" class="nav-toggle" />
				<label for="nav-toggle" class="nav-toggle-label" aria-label="Abrir menú">
					<span></span>
				</label>
				<nav class="site-nav">
					<ul>
						{
							navLinks.map((link) => (
								<li>
									<a href={link.href} data-i18n-en={link.labelEn}>{link.label}</a>
								</li>
							))
						}
					</ul>
				</nav>
				<button
					id="lang-switch"
					type="button"
					class="lang-switch"
					aria-label="Switch to English"
				>
					EN
				</button>
			</div>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<img
				class="footer-flower"
				src="/images/brand/flor-oro.webp"
				alt=""
				width="56"
				height="56"
			/>
			<img
				class="footer-wordmark"
				src="/images/brand/wordmark-arena.webp"
				alt="Naru Estética Avanzada"
				width="220"
				height="77"
			/>
			<p class="footer-tagline" data-i18n-en="Real beauty. Fair prices.">Belleza real. Precio justo.</p>
			<p class="footer-location">Manta, Ecuador</p>
			<p>
				<a href="/contacto" data-i18n-en="Contact / WhatsApp">Contacto / WhatsApp</a>
			</p>
			<p class="footer-copyright" data-i18n-en={`© ${currentYear} Naru Advanced Aesthetics. All rights reserved.`}>© {currentYear} Naru Estética Avanzada. Todos los derechos reservados.</p>
		</footer>

		<!-- Externos (no inline) a propósito: la CSP no permite scripts inline sin
		     'unsafe-inline' — mejor sacar el JS a un archivo propio que debilitar la
		     política. Ver site/public/scripts/tracking.js e i18n.js -->
		<script is:inline src="/scripts/tracking.js"></script>
		<script is:inline src="/scripts/i18n.js"></script>

		<style>
			:global(*) {
				box-sizing: border-box;
			}

			:global(html) {
				scroll-behavior: smooth;
			}

			:global(body) {
				margin: 0;
				background: var(--color-bg);
				color: var(--color-text);
				font-family: var(--font-body);
				font-size: var(--text-base);
				line-height: 1.6;
			}

			:global(h1),
			:global(h2),
			:global(h3) {
				font-family: var(--font-display);
				font-weight: 600;
				color: var(--color-text);
				margin: 0 0 var(--space-4);
				line-height: 1.15;
			}

			:global(a) {
				color: var(--color-accent);
			}

			:global(.container) {
				max-width: 1100px;
				margin: 0 auto;
				padding: 0 var(--space-4);
			}

			:global(.eyebrow) {
				font-family: var(--font-heading);
				font-size: var(--text-xs);
				text-transform: uppercase;
				letter-spacing: var(--tracking-wide);
				color: var(--color-accent);
			}

			.site-header {
				position: relative;
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: var(--space-4) var(--space-5, var(--space-4));
				background: var(--color-verde-botanico);
			}

			.brand {
				display: flex;
				align-items: center;
				gap: var(--space-2);
				text-decoration: none;
			}

			.brand :global(.brand-mark) {
				display: block;
			}

			/* Wordmark real del manual de marca (portada, recortado y recoloreado a Arena) —
			   ver docs/04-desarrollo.md. No es texto con fuente web: es el logotipo exacto,
			   con el detalle del trazo que conecta la A con la R, imposible de replicar con
			   una fuente del sistema. */
			.brand-wordmark {
				height: 36px;
				width: auto;
			}

			@media (min-width: 768px) {
				.brand-wordmark {
					height: 40px;
				}
			}

			.header-right {
				display: flex;
				align-items: center;
				gap: var(--space-3);
			}

			.lang-switch {
				padding: var(--space-1) var(--space-2);
				border: 1px solid var(--color-arena);
				border-radius: var(--radius);
				background: transparent;
				color: var(--color-arena);
				font-family: var(--font-heading);
				font-size: var(--text-xs);
				font-weight: 600;
				letter-spacing: var(--tracking-wide);
				cursor: pointer;
				transition: background 0.2s ease, color 0.2s ease;
			}

			.lang-switch:hover {
				background: var(--color-arena);
				color: var(--color-verde-botanico);
			}

			.nav-toggle {
				display: none;
			}

			.nav-toggle-label {
				display: flex;
				flex-direction: column;
				gap: 5px;
				cursor: pointer;
			}

			.nav-toggle-label span,
			.nav-toggle-label::before,
			.nav-toggle-label::after {
				content: "";
				width: 22px;
				height: 1.5px;
				background: var(--color-arena);
				display: block;
			}

			.site-nav {
				position: absolute;
				top: 100%;
				left: 0;
				right: 0;
				background: var(--color-verde-botanico);
				display: none;
				border-top: 1px solid rgba(241, 239, 239, 0.15);
			}

			.nav-toggle:checked ~ .site-nav {
				display: block;
			}

			.site-nav ul {
				list-style: none;
				margin: 0;
				padding: var(--space-4) var(--space-5, var(--space-4));
				display: flex;
				flex-direction: column;
				gap: var(--space-4);
			}

			.site-nav a {
				color: var(--color-arena);
				text-decoration: none;
				font-family: var(--font-heading);
				font-size: var(--text-sm);
				text-transform: uppercase;
				letter-spacing: var(--tracking-wide);
				opacity: 0.9;
				transition: opacity 0.2s;
			}

			.site-nav a:hover {
				opacity: 1;
			}

			main {
				display: block;
			}

			.site-footer {
				background: var(--color-verde-botanico);
				color: var(--color-arena);
				text-align: center;
				padding: var(--space-12) var(--space-4) var(--space-8);
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: var(--space-1);
			}

			.footer-flower {
				margin-bottom: var(--space-2);
				opacity: 0.9;
			}

			.footer-wordmark {
				height: 44px;
				width: auto;
				margin-bottom: var(--space-1);
			}

			.footer-tagline {
				margin: 0;
				font-size: var(--text-sm);
				color: var(--color-arena);
				opacity: 0.75;
			}

			.footer-location {
				margin: var(--space-2) 0 0;
				font-size: var(--text-sm);
			}

			.site-footer a {
				color: var(--color-naranja);
				font-family: var(--font-heading);
				font-size: var(--text-sm);
				text-decoration: none;
			}

			/* Arena a plena opacidad, no atenuada — el footer ya tuvo un bug de contraste
			   (Verde Salvia sobre Verde Botánico, 1.92:1) por bajar la opacidad en texto
			   chico. Acá el tamaño reducido ya alcanza para que se lea como "letra chica"
			   sin sacrificar legibilidad real. */
			.footer-copyright {
				margin: var(--space-4) 0 0;
				font-size: var(--text-xs);
				color: var(--color-arena);
			}

			/* Desktop (>= 768px): nav siempre visible, sin hamburguesa */
			@media (min-width: 768px) {
				.site-header {
					padding: var(--space-4) var(--space-8);
				}

				.nav-toggle-label {
					display: none;
				}

				.site-nav {
					position: static;
					display: block;
					background: none;
					border-top: none;
				}

				.site-nav ul {
					flex-direction: row;
					padding: 0;
					gap: var(--space-8);
				}
			}
		</style>
	</body>
</html>
